{
  "name": "opencode-symbolic-executor",
  "version": "0.10.7",
  "description": "SPEC-driven development workflow with hash-anchored edits for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-symbolic-executor": "bin/init.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run"
  },
  "keywords": [
    "opencode",
    "plugin",
    "spec-driven",
    "cli",
    "hashline"
  ],
  "license": "MIT",
  "files": [
    "bin/",
    "dist/",
    "registry/",
    ".opencode/templates/",
    "README.md"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.24",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  }
}
