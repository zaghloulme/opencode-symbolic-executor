{
  "$schema": "https://opencode.ai/schemas/config.json",
  "$comment": "MCP servers are configured globally in ~/.config/opencode/opencode.json - DO NOT add example MCPs here",
  "mcpServers": {},
  "toolSearch": {
    "alwaysLoad": [
      "create_spec",
      "review_plan",
      "verify_work"
    ],
    "enableToolSearch": true,
    "bm25Params": {
      "k1": 0.9,
      "b": 0.4
    }
  },
  "symbolicExecutor": {
    "enableSPECWorkflow": true,
    "enableVerification": true,
    "visualThreshold": 0.90,
    "maxRevisions": 3
  }
}
